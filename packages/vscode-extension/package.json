{
  "name": "stencil-vscode",
  "displayName": "Stencil Template Manager",
  "description": "Manage and run Stencil templates directly from VS Code",
  "version": "0.0.1",
  "publisher": "stencil-pm",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:stencil.openTemplate",
    "onCommand:stencil.runTemplate",
    "onCommand:stencil.createTemplate",
    "onCommand:stencil.listTemplates",
    "onCommand:stencil.refreshTemplatesView",
    "onView:stencilTemplates",
    "workspaceContains:**/.stencil/**/*.md"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "stencil-template",
        "aliases": [
          "Stencil Template",
          "stencil-template"
        ],
        "filenamePatterns": [
          "**/.stencil/**/*.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "stencil.openTemplate",
        "title": "Stencil: Open Template"
      },
      {
        "command": "stencil.runTemplate",
        "title": "Stencil: Run Template"
      },
      {
        "command": "stencil.createTemplate",
        "title": "Stencil: Create Template"
      },
      {
        "command": "stencil.listTemplates",
        "title": "Stencil: List Templates"
      },
      {
        "command": "stencil.refreshTemplatesView",
        "title": "Stencil: Refresh Templates View",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "stencil.openTemplate",
          "group": "inline",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        },
        {
          "command": "stencil.runTemplate",
          "group": "navigation",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        }
      ],
      "view/title": [
        {
          "command": "stencil.refreshTemplatesView",
          "group": "navigation",
          "when": "view == stencilTemplates"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "stencilTemplates",
          "name": "Stencil Templates"
        }
      ]
    },
    "grammars": [
      {
        "language": "stencil-template",
        "scopeName": "text.html.markdown.stencil",
        "path": "./syntaxes/stencil-template.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter.stencil": "yaml"
        },
        "unbalancedBracketScopes": [
          "markup.underline.link.markdown",
          "punctuation.definition.list.begin.markdown"
        ]
      }
    ],
    "configurationDefaults": {
      "[stencil-template]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "diffEditor.ignoreTrimWhitespace": false
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:smoke",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:smoke": "pnpm run build && node ./test/runTest.mjs",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "package": "vsce package"
  },
  "dependencies": {
    "@stencil-pm/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
