{
  "name": "stencil-vscode",
  "displayName": "Stencil Template Manager",
  "description": "Manage and run Stencil templates directly from VS Code",
  "version": "0.0.1",
  "publisher": "stencil-pm",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:stencil.openTemplate",
    "onCommand:stencil.runTemplate",
    "onCommand:stencil.runTemplateWithMode",
    "onCommand:stencil.runTemplateInEditor",
    "onCommand:stencil.runTemplateInCopilotChat",
    "onCommand:stencil.runTemplateInCopilotChatSend",
    "onCommand:stencil.runTemplateWithLanguageModel",
    "onCommand:stencil.runTemplateWithLanguageModelSelectModel",
    "onCommand:stencil.runTemplateInCopilotChatWithMode",
    "onCommand:stencil.createTemplate",
    "onCommand:stencil.listTemplates",
    "onCommand:stencil.refreshTemplatesView",
    "onView:stencilTemplates",
    "workspaceContains:**/.stencil/**/*.md"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "stencil-template",
        "aliases": [
          "Stencil Template",
          "stencil-template"
        ],
        "filenamePatterns": [
          "**/.stencil/**/*.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "stencil.openTemplate",
        "title": "Stencil: Open Template"
      },
      {
        "command": "stencil.runTemplate",
        "title": "Stencil: Run Template"
      },
      {
        "command": "stencil.runTemplateWithMode",
        "title": "Stencil: Run Template With Mode..."
      },
      {
        "command": "stencil.runTemplateInEditor",
        "title": "Stencil: Run Template in Editor"
      },
      {
        "command": "stencil.runTemplateInCopilotChat",
        "title": "Stencil: Run Template in Copilot Chat"
      },
      {
        "command": "stencil.runTemplateInCopilotChatSend",
        "title": "Stencil: Run Template in Copilot Chat (Send)"
      },
      {
        "command": "stencil.runTemplateWithLanguageModel",
        "title": "Stencil: Run Template with Language Model"
      },
      {
        "command": "stencil.runTemplateWithLanguageModelSelectModel",
        "title": "Stencil: Run Template with Language Model (Select Model)"
      },
      {
        "command": "stencil.runTemplateInCopilotChatWithMode",
        "title": "Stencil: Run Template in Copilot Chat (Select Mode)"
      },
      {
        "command": "stencil.createTemplate",
        "title": "Stencil: Create Template"
      },
      {
        "command": "stencil.listTemplates",
        "title": "Stencil: List Templates"
      },
      {
        "command": "stencil.refreshTemplatesView",
        "title": "Stencil: Refresh Templates View",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Stencil",
      "properties": {
        "stencil.run.defaultTarget": {
          "type": "string",
          "enum": [
            "editor",
            "copilot-chat",
            "lm-api"
          ],
          "default": "copilot-chat",
          "markdownDescription": "Default delivery target for `Stencil: Run Template` when no per-run selection behavior overrides it."
        },
        "stencil.run.defaultMode": {
          "type": "string",
          "enum": [
            "default",
            "insert",
            "send",
            "execute"
          ],
          "default": "default",
          "markdownDescription": "Default run mode. Invalid combinations are normalized to a safe target-specific mode."
        },
        "stencil.run.defaultChatMode": {
          "type": "string",
          "enum": [
            "ask",
            "edit",
            "agent"
          ],
          "default": "ask",
          "markdownDescription": "Preferred Copilot Chat sub-mode when the selected run profile targets Copilot Chat."
        },
        "stencil.run.selectionBehavior": {
          "type": "string",
          "enum": [
            "defaults",
            "picker",
            "last-used"
          ],
          "default": "defaults",
          "markdownDescription": "How `Stencil: Run Template` chooses its run profile."
        },
        "stencil.run.lastUsedScope": {
          "type": "string",
          "enum": [
            "session",
            "workspace",
            "global"
          ],
          "default": "session",
          "markdownDescription": "Where the last-used run profile is stored when selection behavior is set to `last-used`."
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "stencil.runTemplate",
          "group": "inline",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        },
        {
          "command": "stencil.openTemplate",
          "group": "navigation",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        },
        {
          "command": "stencil.runTemplateWithMode",
          "group": "navigation",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        },
        {
          "command": "stencil.runTemplateInEditor",
          "group": "navigation",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        },
        {
          "command": "stencil.runTemplateInCopilotChat",
          "group": "navigation",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        },
        {
          "command": "stencil.runTemplateInCopilotChatSend",
          "group": "navigation",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        },
        {
          "command": "stencil.runTemplateWithLanguageModel",
          "group": "navigation",
          "when": "view == stencilTemplates && viewItem == stencil.template"
        }
      ],
      "view/title": [
        {
          "command": "stencil.refreshTemplatesView",
          "group": "navigation",
          "when": "view == stencilTemplates"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "stencilTemplates",
          "name": "Stencil Templates"
        }
      ]
    },
    "grammars": [
      {
        "language": "stencil-template",
        "scopeName": "text.html.markdown.stencil",
        "path": "./syntaxes/stencil-template.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter.stencil": "yaml"
        },
        "unbalancedBracketScopes": [
          "markup.underline.link.markdown",
          "punctuation.definition.list.begin.markdown"
        ]
      }
    ],
    "configurationDefaults": {
      "[stencil-template]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "diffEditor.ignoreTrimWhitespace": false
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:smoke",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:smoke": "pnpm run build && node ./test/runTest.mjs",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "package": "vsce package"
  },
  "dependencies": {
    "@stencil-pm/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
